{
  "name": "bug-tracker-backend",
  "version": "2.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "bun-types": "^1.3.10",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.8.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/client": "^7.4.1",
    "@trpc/server": "^11.10.0",
    "prisma": "^7.4.1",
    "zod": "^4.3.6"
  },
  "scripts": {
    "test": "bun test",
    "test:unit": "bun --env-file=.env.test test",
    "test:prepare": "bunx prisma migrate reset --force && bunx prisma generate",
    "test:all": "bunx test:prepare && bunx test:unit",
    "reset:dev-db": "bunx prisma migrate reset --force",
    "lint": "bunx eslint .",
    "start:e2e": "bun run app/server.ts"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  }
}
